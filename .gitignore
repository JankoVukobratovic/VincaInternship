# Raw scan data (large, tens of thousands of MCA files) - distributed
# separately (see README: Setup). Covers both accepted layouts:
# under Resources/ and dropped directly into the repo root.
/Resources/
/aurora-antico1-*/
/antico1-*/

# Local model checkpoints
/models/
*.pth
*.pt
# ...except the small (6.7 MB) trained U-Net - hard to reproduce exactly
# (stochastic training), required by 05_full_pipeline.py:
!xrf-denoise/experiments/A_scratch/checkpoints/best_model.pt

# Camera-ready figure exports (regenerate with scripts/make_submission_figures.py)
/submission/

# Per-pixel spectrum plot dumps (large, regenerate)
/signals_prova1/
/signals_prova2/

# Numpy caches and processed arrays
*.npy
**/_npy_cache/

# Archives
*.zip

# OS / IDE junk
.DS_Store
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/
# Derived R(E) cache (regenerated by 06)
xrf-denoise/data/processed/*.npz

# ...and the cross-detector N2N checkpoint, so the fusion table
# reproduces without retraining:
!xrf-denoise/experiments/cross_detector/checkpoints/best_model.pt
